{
  "datasets": [
    {
      "name": "90799f0d",
      "displayName": "KPI_Fraude",
      "queryLines": [
        "SELECT\r\n",
        "    SUM(total_transactions) AS total_transactions,\r\n",
        "    SUM(fraud_transactions) AS fraud_transactions,\r\n",
        "    SUM(legitimate_transactions) AS legitimate_transactions,\r\n",
        "    SUM(fraud_amount) AS fraud_amount,\r\n",
        "    ROUND(\r\n",
        "        100.0 * SUM(fraud_transactions)\r\n",
        "        / NULLIF(SUM(total_transactions), 0),\r\n",
        "        2\r\n",
        "    ) AS fraud_rate_pct\r\n",
        "FROM banking_prod.golden.agg_fraud_daily;"
      ]
    },
    {
      "name": "5e81837a",
      "displayName": "Evolucion_diaria_fraude",
      "queryLines": [
        "SELECT\r\n",
        "    transaction_date,\r\n",
        "    SUM(total_transactions) AS total_transactions,\r\n",
        "    SUM(fraud_transactions) AS fraud_transactions,\r\n",
        "    SUM(legitimate_transactions) AS legitimate_transactions,\r\n",
        "    SUM(fraud_amount) AS fraud_amount,\r\n",
        "    ROUND(\r\n",
        "        100.0 * SUM(fraud_transactions)\r\n",
        "        / NULLIF(SUM(total_transactions), 0),\r\n",
        "        2\r\n",
        "    ) AS fraud_rate_pct\r\n",
        "FROM banking_prod.golden.agg_fraud_daily\r\n",
        "GROUP BY transaction_date\r\n",
        "ORDER BY transaction_date;"
      ]
    },
    {
      "name": "98d52ff2",
      "displayName": "Creditos_sbs",
      "queryLines": [
        "SELECT\r\n",
        "    fecha_corte,\r\n",
        "    concepto,\r\n",
        "    total_creditos_miles_soles\r\n",
        "FROM banking_prod.golden.agg_sbs_creditos\r\n",
        "WHERE nivel_jerarquia = 0\r\n",
        "  AND concepto <> 'TOTAL DE CRÉDITOS'\r\n",
        "ORDER BY total_creditos_miles_soles DESC;"
      ]
    },
    {
      "name": "f99866bb",
      "displayName": "Depositos_sbs",
      "queryLines": [
        "SELECT\r\n",
        "    fecha_corte,\r\n",
        "    moneda,\r\n",
        "    SUM(numero_cuentas) AS numero_cuentas,\r\n",
        "    SUM(saldo_final_miles_soles) AS saldo_final_miles_soles\r\n",
        "FROM banking_prod.golden.agg_sbs_depositos\r\n",
        "GROUP BY fecha_corte, moneda\r\n",
        "ORDER BY fecha_corte, moneda;"
      ]
    },
    {
      "name": "980cae52",
      "displayName": "Morosidad_sbs",
      "queryLines": [
        "SELECT\r\n",
        "    fecha_corte,\r\n",
        "    empresa_bancaria,\r\n",
        "    morosidad_pct\r\n",
        "FROM banking_prod.golden.agg_sbs_morosidad\r\n",
        "WHERE concepto_credito = 'Total Créditos Directos'\r\n",
        "  AND empresa_bancaria <> 'TOTAL BANCA MÚLTIPLE'\r\n",
        "ORDER BY morosidad_pct DESC;"
      ]
    }
  ],
